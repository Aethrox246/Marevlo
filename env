# ── Environment ─────────────────────────────────────────────────────────────
# `dev` for local docker compose.  Switch to `prod` only when deploying to AWS
# (and at that point JWT_SECRET, S3_BUCKET, etc. must all be real values).
ENV=dev
DEBUG=false
LOG_FORMAT=text
RATE_LIMIT_ENABLED=true

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=marevlo_user
POSTGRES_PASSWORD=YTM0YTllNzEtZWJmNi00NzUxLWIyNWYtOGI0YzI2Nzc3OTc40b2b02106d7c4b2db71b16ba93147f6f
POSTGRES_DB=marevlo_db
# Host-side port. The container itself still listens on 5432 internally;
# this maps it to a different host port so it doesn't fight the Postgres
# you already have running on your machine.
POSTGRES_PORT=5433

# ── Redis ───────────────────────────────────────────────────────────────────
# Host-side port. Container still listens on 6379 internally; this maps it
# elsewhere so it doesn't fight Redis you may have running on the host.
REDIS_PORT=6380

# ── Backend (FastAPI) ───────────────────────────────────────────────────────
BACKEND_PORT=8000
JWT_SECRET=N2EwYzRkNjgtOGRjMy00NDlmLTlmMTktNDE5NTM1YzIyYWVmb61d031d6bdb433595d7dbfb9704f81e
JWT_ALGORITHM=HS256
TRUSTED_PROXIES=127.0.0.1/32

# Local Vite (5173) + Vercel prod must both be allowed.
CORS_ORIGINS=https://marevlo.vercel.app,http://localhost:5173,http://localhost:3000

# ── JupyterHub ──────────────────────────────────────────────────────────────
JUPYTERHUB_PORT=8001
# Local dev: the hub runs in compose on host port 8001.
# When deploying to EC2, switch to your Caddy URL:
#   NOTEBOOK_BASE_URL=https://notebook.13.205.159.122.sslip.io
NOTEBOOK_BASE_URL=http://localhost:8001

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# ── MIRA (AI tutor module) ─────────────────────────────────────────────────
# Required for real Claude calls. Without it MIRA falls back to MockClaudeClient.
ANTHROPIC_API_KEY=
# Optional. Without it embeddings use a low-quality FakeEmbedder.
OPENAI_API_KEY=
# Qdrant runs as a docker compose service; no need to override unless you
# point it at an external instance.
QDRANT_PORT=6333
# Static token for /admin/mira/* endpoints. Send as `X-Admin-Token` header.
# Rotate any time by replacing this value and `docker compose restart api`.
MIRA_ADMIN_TOKEN=KfgTTocOOz-KRp7Q2HW6DCx4985xFpgtXQ3nbNy2kzQ
# Feature gates — local dev: open to all logged-in users.
# When you ship to EC2, flip back to MIRA_ENABLED_FOR_ALL=false and use
# MIRA_ENABLED_USER_IDS=1,2,3,... for the pilot allowlist.
MIRA_ENABLED_FOR_ALL=true
MIRA_ENABLED_USER_IDS=
MIRA_ADMIN_USER_IDS=1
MIRA_GLOBAL_KILL=false
# Local-dev-only escape hatch (accepts X-Dev-User-Id header). Never enable in prod.
MIRA_DEV_MODE_ALLOW_HEADER_UID=false
